# Base de données. En production : l'URL Neon (postgresql://…?sslmode=require).
# Sans valeur, une base SQLite locale (soonfinance.db) est utilisée.
DATABASE_URL=

# Environnement : « development » (lien de connexion renvoyé et journalisé) ou « production ».
ENV=

# URL publique du site (sert à construire le lien magique). Défaut : http://localhost:3000
APP_URL=

# Clé API Resend. Sans clé, le lien de connexion est seulement journalisé (développement).
RESEND_API_KEY=

# Expéditeur des e-mails. Défaut : Soon Finance <onboarding@resend.dev>
EMAIL_FROM=

# E-mails administrateurs, séparés par des virgules (rôle « admin » à la création du compte).
ADMIN_EMAILS=
